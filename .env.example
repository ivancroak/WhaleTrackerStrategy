# Polygon wallet private key (NEVER commit the real .env file)
PRIVATE_KEY=0x_your_private_key_here

# Polymarket CLOB API credentials
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polygonscan API (free tier: 5 req/sec)
# Get key at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=

# Arkham Intelligence API (optional — not required, Polymarket Data API covers whale tracking)
# ARKHAM_API_KEY=
